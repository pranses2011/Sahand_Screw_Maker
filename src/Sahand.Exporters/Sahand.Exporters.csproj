    قید: بدون وابستگی NuGet در زمان اجرا — تمام فرمت‌ها دستی و با مجوز باز نوشته می‌شوند.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sahand.Exporters</RootNamespace>
