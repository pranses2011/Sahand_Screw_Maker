    قید: ارسال فقط با رضایت کاربر + پیکربندی + شبکه؛ هستهٔ برنامه آفلاین می‌ماند (سند ۵).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sahand.Reporting</RootNamespace>
    <AssemblyName>Sahand.Reporting</AssemblyName>
