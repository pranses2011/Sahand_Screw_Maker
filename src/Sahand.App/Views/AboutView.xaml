<UserControl x:Class="Sahand.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        درباره و حمایت — اطلاعات سازنده (سند ۵-۷) و نمایش پوشیدهٔ شمارهٔ کارت (PRIV-02).
        شمارهٔ کارت فقط در همین صفحه و به‌صورت پوشیده است؛ با اقدام آگاهانهٔ کاربر
        آشکار/کپی می‌شود و در هیچ گزارش/فایل/لاگی ذخیره نمی‌شود.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" MaxWidth="680" HorizontalAlignment="Right">
            <TextBlock Text="دربارهٔ برنامه" FontSize="{StaticResource FontSize.Header}"
                       FontWeight="Bold" Margin="0,0,0,10"/>

            <GroupBox Header="شناسنامه" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="نام فارسی:" Width="150"/>
                        <TextBlock Text="طراح پیچ و مهره سهند" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="نام انگلیسی:" Width="150"/>
                        <TextBlock Text="Sahand Screw &amp; Nut Designer" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="نسخه:" Width="150"/>
                        <TextBlock x:Name="VersionText" Text="0.3.0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="موتور هندسه:" Width="150"/>
                        <TextBlock Text="مش پارامتریک داخلی (رزوهٔ مارپیچ واقعی) — بدون هستهٔ B-Rep؛ خروجی STEP در برنامهٔ توسعه"
                                   TextWrapping="Wrap" MaxWidth="430"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="وضعیت آفلاین:" Width="150"/>
                        <TextBlock Text="طراحی/ذخیره/خروجی کاملاً آفلاین؛ فقط ارسال ایمیل نیازمند شبکه است"
                                   TextWrapping="Wrap" MaxWidth="430"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="سازنده" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="نام:" Width="150"/>
                        <TextBlock Text="سعید نجفی"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="شمارهٔ تماس:" Width="150"/>
                        <TextBlock Text="۰۹۱۴۴۲۲۰۴۳۰" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="ایمیل:" Width="150"/>
                        <TextBlock x:Name="EmailText" Text="Pranses2011@GMail.com" FlowDirection="LeftToRight"
                                   Cursor="Hand" MouseLeftButtonDown="OnEmailClick"
                                   ToolTip="با کلیک، نرم‌افزار ایمیل باز نمی‌شود؛ نشانی انتخاب می‌شود (سند ۵-۷)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="وب‌سایت:" Width="150"/>
                        <TextBlock x:Name="SiteText" Text="EA-Fixer.ir" FlowDirection="LeftToRight"
                                   Cursor="Hand" MouseLeftButtonDown="OnSiteClick"
                                   ToolTip="فقط با کلیک خودتان در مرورگر بیرونی باز می‌شود"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="حمایت از توسعهٔ برنامه" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="اگر این ابزار برایتان مفید بود، می‌توانید از توسعهٔ آن حمایت کنید. شمارهٔ کارت به‌صورت پوشیده نمایش داده می‌شود."
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="بانک سامان:" Width="110" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CardText" Text="6219 •••• •••• 4679" FlowDirection="LeftToRight"
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="RevealCardButton" Content="نمایش شمارهٔ کارت"
                                Style="{StaticResource SecondaryButton}" MinWidth="120" Click="OnRevealCardClick"/>
                        <Button x:Name="CopyCardButton" Content="کپی شمارهٔ کارت"
                                Margin="8,0,0,0" MinWidth="120" Click="OnCopyCardClick"/>
                    </StackPanel>
                    <TextBlock x:Name="CardHintText" Text=""
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0"
                               FontSize="{StaticResource FontSize.Small}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="مجوزها" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="فونت وزیرمتن (نسخهٔ ۳۳.۰۰۳) با مجوز آزاد SIL Open Font License همراه برنامه است؛ فایل مجوز در پکیج نصب موجود است."
                               TextWrapping="Wrap" Margin="0,3"/>
                    <TextBlock Text="این برنامه تراکنش پرداخت انجام نمی‌دهد و هیچ گواهی طراحی سازه‌ای/باربری صادر نمی‌کند."
                               TextWrapping="Wrap" Margin="0,3"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
