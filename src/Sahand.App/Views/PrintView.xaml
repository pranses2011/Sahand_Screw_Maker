<UserControl x:Class="Sahand.App.Views.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        آماده‌سازی چاپ — پروفایل فرایند/لقی و ساخت «نسخهٔ چاپی» جدا از اسمی (سند ۴-۱/۴-۲).
        جدول تفاوت (پارامتر/اسمی/چاپی/علت) پیش از استفاده نمایش داده می‌شود.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" MaxWidth="760" HorizontalAlignment="Right">
            <TextBlock Text="آماده‌سازی چاپ سه‌بعدی" FontSize="{StaticResource FontSize.Header}"
                       FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="نسخهٔ چاپی «مشتق‌شده و قابل بازبینی» است؛ مدل اسمی هرگز بی‌صدا تغییر نمی‌کند."
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <GroupBox Header="پروفایل چاپ" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="فرایند:" Width="170" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProcessBox" Width="180">
                            <ComboBoxItem Content="FDM / FFF (رشته‌مذاب)" Tag="Fdm" IsSelected="True"/>
                            <ComboBoxItem Content="SLA / MSLA (رزینی)" Tag="Sla"/>
                            <ComboBoxItem Content="SLS (پودری)" Tag="Sls"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="قطر نازل (mm):" Width="170" VerticalAlignment="Center"/>
                        <TextBox x:Name="NozzleBox" Width="110" FlowDirection="LeftToRight" Text="0.4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="ارتفاع لایه (mm):" Width="170" VerticalAlignment="Center"/>
                        <TextBox x:Name="LayerBox" Width="110" FlowDirection="LeftToRight" Text="0.2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="حالت اتصال/فیت:" Width="170" VerticalAlignment="Center"
                                   ToolTip="مقادیر «پیشنهاد» هستند؛ تضمین فیت یا استحکام نیست"/>
                        <ComboBox x:Name="FitBox" Width="180">
                            <ComboBoxItem Content="نزدیک (Snug) — پیشنهاد ۰٫۱۵mm" Tag="Snug" IsSelected="True"/>
                            <ComboBoxItem Content="لغزش‌دار (Loose) — پیشنهاد ۰٫۳۵mm" Tag="Loose"/>
                            <ComboBoxItem Content="فشاری (Press) — پیشنهاد −۰٫۱۰mm" Tag="Press"/>
                            <ComboBoxItem Content="لقی عددی سفارشی" Tag="Custom"/>
                        </ComboBox>
                        <TextBox x:Name="CustomClearanceBox" Width="80" FlowDirection="LeftToRight"
                                 Text="0.2" Margin="8,0,0,0" ToolTip="فقط برای حالت سفارشی — برحسب mm"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="جبران شعاعی رزوهٔ خارجی (mm):" Width="170" VerticalAlignment="Center"
                                   ToolTip="مثبت = ریزتر کردن پیچ؛ قرارداد علامت در جدول تفاوت هم نمایش داده می‌شود"/>
                        <TextBox x:Name="ExternalCompBox" Width="110" FlowDirection="LeftToRight" Text="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="جبران شعاعی رزوهٔ داخلی (mm):" Width="170" VerticalAlignment="Center"
                                   ToolTip="مثبت = درشت‌تر کردن حفرهٔ مهره"/>
                        <TextBox x:Name="InternalCompBox" Width="110" FlowDirection="LeftToRight" Text="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="پخ شروع ورود رزوه (mm):" Width="170" VerticalAlignment="Center"/>
                        <TextBox x:Name="LeadInBox" Width="110" FlowDirection="LeftToRight" Text="0.3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="انقباض ماده (٪):" Width="170" VerticalAlignment="Center"
                                   ToolTip="تقریب — از روی فایل حدس زده نمی‌شود"/>
                        <TextBox x:Name="ShrinkBox" Width="110" FlowDirection="LeftToRight" Text="0.5"/>
                    </StackPanel>
                    <CheckBox x:Name="ApplyShrinkCheck" Content="اعمال جبران انقباض (مقیاس کلی قطر)"
                              IsChecked="False" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                <Button x:Name="DeriveButton" Content="ساخت نسخهٔ چاپی" MinWidth="150" Click="OnDeriveClick"/>
                <Button Content="نمونهٔ آزمون رزوه (کوپن کوتاه)" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" MinWidth="190" Click="OnCouponClick"
                        ToolTip="قطعهٔ کوتاه ۴ گامی برای تنظیم فیت پیش از چاپ کامل — نمونهٔ آزمون است، استاندارد نیست"/>
            </StackPanel>

            <GroupBox Header="جدول تفاوت: اسمی در برابر چاپی" Margin="0,0,0,10"
                      Visibility="{Binding DiffVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DataGrid x:Name="DiffGrid" Height="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="پارامتر" Binding="{Binding ParameterLabel}" Width="170"/>
                        <DataGridTextColumn Header="اسمی" Binding="{Binding NominalValue}" Width="90"/>
                        <DataGridTextColumn Header="چاپی" Binding="{Binding PrintValue}" Width="90"/>
                        <DataGridTextColumn Header="علت" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Border Background="#FFF6E0" CornerRadius="6" Padding="10">
                <TextBlock Text="هشدار: مقادیر لقی/جبران فقط «پیشنهاد» بر پایهٔ تجربهٔ عمومی چاپ‌اند و به دستگاه/ماده/دقت شما وابسته‌اند؛ تضمین فیت یا استحکام نیستند. پیش از قطعهٔ کامل، نمونهٔ آزمون رزوه را چاپ کنید."
                           TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}"
                           FontSize="{StaticResource FontSize.Small}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
