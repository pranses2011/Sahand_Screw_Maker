<UserControl x:Class="Sahand.App.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sahand.App.Controls">
    <!--
        نمای پیش‌نمایش سه‌بعدی — صحنه + خلاصه وضعیت و انتخاب نسخهٔ اسمی/چاپی (سند ۲-۵).
    -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.PanelBackground}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="پیش‌نمایش سه‌بعدی" FontSize="{StaticResource FontSize.Header}"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <RadioButton x:Name="NominalRadio" GroupName="Version" Content="نسخهٔ اسمی"
                             Margin="20,0,0,0" VerticalAlignment="Center" IsChecked="True"
                             Checked="OnVersionChanged"/>
                <RadioButton x:Name="PrintRadio" GroupName="Version" Content="نسخهٔ چاپی (اگر ساخته باشید)"
                             Margin="10,0,0,0" VerticalAlignment="Center" Checked="OnVersionChanged"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <controls:SceneViewport x:Name="Viewport" Grid.Column="0" Margin="6"/>

            <Border Grid.Column="1" Background="{StaticResource Brush.PanelBackground}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0" Padding="10" Margin="0,6,6,6">
                <StackPanel>
                    <TextBlock Text="خلاصهٔ مدل" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ModelInfoText" Text="مدلی ساخته نشده است. از بخش «طراحی قطعه» مدل بسازید."
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="{StaticResource FontSize.Small}"/>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="اعتبارسنجی هندسی" FontWeight="Bold" Margin="0,4,0,6"/>
                    <TextBlock x:Name="ValidationInfoText" Text="—"
                               TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}"/>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="متریال نمایشی" FontWeight="Bold" Margin="0,4,0,6"/>
                    <ComboBox x:Name="MaterialBox" SelectionChanged="OnMaterialChanged"/>
                    <TextBlock Text="متریال فقط ظاهر نمایشی است و خواص مکانیکی یا جنس چاپ را تضمین نمی‌کند."
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
