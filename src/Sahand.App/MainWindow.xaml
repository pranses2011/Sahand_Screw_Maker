<Window x:Class="Sahand.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sahand.App.Views"
        Title="طراح پیچ و مهره سهند — Sahand Screw &amp; Nut Designer"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Vazirmatn}"
        Background="{StaticResource Brush.WindowBackground}"
        Width="1280" Height="820" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <!--
        پوستهٔ اصلی: نوار کناری راست (ناوبری فارسی با آیکون + برچسب — سند ۲-۲) و
        میزبان محتوا. راست‌چینی واقعی است: ترتیب ستون‌ها، جهت ناوبری و focus با RTL.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- نوار کناری راست — برند با آیکون رسمی خود برنامه (بهبود ۰٫۳٫۰) -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" Padding="0,12">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="8,4,8,6">
                    <Image Source="Resources/ScrewIcon.png" Width="44" Height="44"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           ToolTip="طراح پیچ و مهره سهند"/>
                </StackPanel>
                <TextBlock Text="طراح پیچ و مهره سهند"
                           Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="8,2,8,4" TextAlignment="Center"/>
                <TextBlock Text="Sahand Screw &amp; Nut Designer"
                           Foreground="{StaticResource Brush.SidebarSubtitle}" FontSize="12"
                           HorizontalAlignment="Center" Margin="8,0,8,10" TextAlignment="Center"/>

                <Separator Background="#24394A" Height="1" Margin="10,0,10,10"/>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnNavSelectionChanged"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         Margin="6,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}"/>
                            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <!-- نوار accent سمت راست آیتم انتخاب‌شده (نشانهٔ بصری RTL). -->
                                            <Border x:Name="accentBar" Width="3" CornerRadius="1.5"
                                                    HorizontalAlignment="Right" Margin="0,1" Background="Transparent"/>
                                            <Border x:Name="itemBorder" Background="Transparent"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                                <ContentPresenter/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background"
                                                        Value="{StaticResource Brush.SidebarSelected}"/>
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.SidebarSelectedText}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="accentBar" Property="Background"
                                                        Value="{StaticResource Brush.SidebarAccentBar}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background"
                                                        Value="{StaticResource Brush.SidebarHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Home}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="خانه" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Part}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="طراحی قطعه" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.View}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="پیش‌نمایش سه‌بعدی" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Print}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="آماده‌سازی چاپ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Export}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="خروجی" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="تنظیمات و گزارش" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Info}" Style="{StaticResource NavIcon}" Margin="0,0,10,0"/>
                            <TextBlock Text="درباره و حمایت" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- وضعیت آفلاین/صف گزارش در پایین نوار -->
                <StackPanel VerticalAlignment="Bottom" Margin="10,20,10,0">
                    <TextBlock x:Name="QueueStatusText" Text="گزارش‌ها: صف محلی"
                               Foreground="{StaticResource Brush.SidebarSubtitle}" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- میزبان محتوا -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="14"/>
    </Grid>
</Window>
