<UserControl x:Class="Sahand.App.Controls.SceneViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             Focusable="True"
             Background="#202B33">
    <!--
        چیدمان این کنترل LTR است چون صحنهٔ سه‌بعدی جهت ریاضی استاندارد دارد؛
        برچسب‌های فارسی بیرون کنترل RTL می‌مانند (تفکیک سند ۲-۱).
    -->
    <Grid>
        <Viewport3D x:Name="Viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" Position="40,35,55" LookDirection="-40,-35,-55"
                                   UpDirection="0,1,0" FieldOfView="45"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#667788"/>
                        <DirectionalLight x:Name="KeyLight" Color="#DDDDDD" Direction="-0.4,-0.8,-0.45"/>
                        <DirectionalLight Color="#556677" Direction="0.5,0.3,0.6"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <ModelVisual3D x:Name="PartModel"/>
        </Viewport3D>

        <!-- نوار ابزار کوچک نما -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
            <Button x:Name="FitButton" Content="جا دادن" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                    FontSize="12" Padding="8,3" Click="OnFitClick" ToolTip="بازگرداندن کامل مدل در نما"/>
            <Button x:Name="FrontButton" Content="روبه‌رو" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                    FontSize="12" Padding="8,3" Click="OnFrontClick" ToolTip="نمای روبه‌رو (از پایین قطعه)"/>
            <Button x:Name="IsoButton" Content="ایزو" Style="{StaticResource SecondaryButton}"
                    FontSize="12" Padding="8,3" Click="OnIsoClick" ToolTip="نمای ایزومتریک"/>
        </StackPanel>

        <!-- راهنمای کوتاه ماوس -->
        <TextBlock Text="چرخش: درگ چپ — بزرگ‌نمایی: چرخ ماوس — جابه‌جایی: درگ راست"
                   Foreground="#93A7B4" FontSize="11" FontFamily="{StaticResource Vazirmatn}"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"/>
    </Grid>
</UserControl>
