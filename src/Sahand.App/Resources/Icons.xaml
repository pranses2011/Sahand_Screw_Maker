<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        آیکون‌های خطی یکدست (Path ساده با GeometricPen) — جایگزین emoji در رابط اصلی (سند ۲-۶).
        همهٔ آیکون‌ها ۲۴×۲۴ با stroke یکنواخت؛ رنگ از Foreground کنترل گرفته می‌شود.
    -->

    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <!-- خانه -->
    <Geometry x:Key="Icon.Home">M3 11.5 L12 4 L21 11.5 M5.5 10 L5.5 20 L18.5 20 L18.5 10 M10 20 L10 14.5 L14 14.5 L14 20</Geometry>

    <!-- قطعه (پیچ) -->
    <Geometry x:Key="Icon.Part">M9 4 L15 4 L15 8 L9 8 Z M9 8 C9 10 15 10 15 12 C15 14 9 14 9 16 C9 18 15 18 15 20</Geometry>

    <!-- رزوه -->
    <Geometry x:Key="Icon.Thread">M4 5 L4 7 L9 7 L9 5 M13 5 L13 7 L18 7 L18 5 M4 10 L4 12 L9 12 L9 10 M13 10 L13 12 L18 12 L18 10 M4 15 L4 17 L9 17 L9 15 M13 15 L13 17 L18 17 L18 15 M11 4 L11 19</Geometry>

    <!-- نما سه‌بعدی -->
    <Geometry x:Key="Icon.View">M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M12 3 L12 12 M4 7.5 L12 12 L20 7.5 M12 12 L12 21</Geometry>

    <!-- چاپ -->
    <Geometry x:Key="Icon.Print">M7 8 L7 4 L17 4 L17 8 M7 16 L4 16 L4 8 L20 8 L20 16 L17 16 M7 13 L17 13 L17 20 L7 20 Z</Geometry>

    <!-- خروجی -->
    <Geometry x:Key="Icon.Export">M12 15 L12 3 M8 7 L12 3 L16 7 M5 12 L5 20 L19 20 L19 12</Geometry>

    <!-- ذخیره -->
    <Geometry x:Key="Icon.Save">M5 4 L17 4 L20 7 L20 20 L5 20 Z M8 4 L8 10 L15 10 L15 4 M8 14 L16 14 L16 20 L8 20 Z</Geometry>

    <!-- هشدار -->
    <Geometry x:Key="Icon.Warning">M12 3 L22 20 L2 20 Z M12 9 L12 14 M12 17 L12 18</Geometry>

    <!-- اطلاعات -->
    <Geometry x:Key="Icon.Info">M12 4 C16.4 4 20 7.6 20 12 C20 16.4 16.4 20 12 20 C7.6 20 4 16.4 4 12 C4 7.6 7.6 4 12 4 Z M12 10.5 L12 16 M12 7.5 L12 8.2</Geometry>

    <!-- تنظیمات -->
    <Geometry x:Key="Icon.Settings">M12 9 C13.7 9 15 10.3 15 12 C15 13.7 13.7 15 12 15 C10.3 15 9 13.7 9 12 C9 10.3 10.3 9 12 9 Z M12 3 L12 6 M12 18 L12 21 M4.2 7.5 L6.9 9 M17.1 15 L19.8 16.5 M4.2 16.5 L6.9 15 M17.1 9 L19.8 7.5</Geometry>

    <!-- گزارش (پاکت) -->
    <Geometry x:Key="Icon.Mail">M3 6 L21 6 L21 19 L3 19 Z M3 6 L12 13 L21 6</Geometry>
</ResourceDictionary>
