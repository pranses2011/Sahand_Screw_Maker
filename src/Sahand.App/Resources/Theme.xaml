<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        تم روشن برنامه — پالت خنثی مهندسی با accent آبی فولادی.
        فونت وزیرمتن از Resource همراه بسته لود می‌شود (مسیر pack)؛ نصب فونت در Windows لازم نیست.
        همهٔ متن‌ها فارسی و اندازه‌ها برای مقیاس ۱۲۵–۲۰۰٪ DPI خوانا هستند.
        بهبود خوانایی ۰٫۳٫۰: کنتراست متن‌های ثانویه/کناری بالا رفت؛ وضعیت انتخاب/هاور منوی
        کناری با رنگ‌های اختصاصی واضح شد (به‌جای شفافیت ۰٫۸۵ که تقریباً نامرئی بود).
    -->

    <!-- فونت وزیرمتن (استاتیک — بدون وابستگی به Variable Font). -->
    <FontFamily x:Key="Vazirmatn">pack://application:,,,/Fonts/#Vazirmatn</FontFamily>

    <!-- پالت تم روشن (بهبود کنتراست ۰٫۳٫۰). -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#C9D1D9"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1B242E"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#46525C"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#0F6BAE"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E3F0FA"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#1C7A3D"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5E00"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#B3261E"/>

    <!-- پالت منوی کناری — متن‌های روشن‌تر و حالت‌های واضح انتخاب/هاور (۰٫۳٫۰). -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#15242F"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#EAF2F7"/>
    <SolidColorBrush x:Key="Brush.SidebarSubtitle" Color="#AEC2CE"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#21394A"/>
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#0F6BAE"/>
    <SolidColorBrush x:Key="Brush.SidebarSelectedText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SidebarAccentBar" Color="#5FB0F2"/>

    <sys:Double x:Key="FontSize.Base">14</sys:Double>
    <sys:Double x:Key="FontSize.Header">18</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>

    <!-- استایل پایهٔ کنترل‌ها با فونت وزیرمتن. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#B9C4CC"/>
                            <Setter Property="Foreground" Value="#EAF0F3"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Header}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    </Style>

    <!-- دکمهٔ ثانویه (خنثی) — هاور با زمینهٔ تیره‌تر (به‌جای کاهش شفافیت نامحسوس). -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#E7EBEF"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D5DDE4"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
